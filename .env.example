# このファイルを .env にコピーして使います（.env は git 管理外）。
# 公開するときの設定は docs/07-deployment.md を参照してください。

# ───────── データの保存先 ─────────
APP_DATABASE_PATH=data/app.db
APP_UPLOAD_DIR=data/uploads
APP_BACKUP_DIR=data/backups
# 残しておくバックアップの数（古いものから削除）
APP_BACKUP_KEEP=14

# ───────── セッション・セキュリティ ─────────
APP_SESSION_EXPIRE_HOURS=168
# 公開（HTTPS）では true にする。Cookie に Secure を付け、HSTS ヘッダーを送る
APP_COOKIE_SECURE=false
# API 仕様書（/docs）を公開するか。公開環境では false を推奨
APP_ENABLE_API_DOCS=true

# ───────── ログ ─────────
# DEBUG / INFO / WARNING / ERROR
APP_LOG_LEVEL=INFO
# 指定するとファイルにも出力する（10MB ごとに切り替え、5世代まで残す）
# APP_LOG_FILE=data/logs/app.log
